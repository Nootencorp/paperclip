# Supply-chain hardening: do not let installs silently rewrite the lockfile or
# auto-pull peer dependencies. Runtime service should start from the checked-out
# repo/node_modules, not from npm registry resolution.
auto-install-peers=false
frozen-lockfile=true
prefer-frozen-lockfile=true
save-exact=true
save-prefix=
package-manager-strict=true
engine-strict=true
